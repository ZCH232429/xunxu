EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Set only after the provider is configured and tested in Supabase.
EXPO_PUBLIC_PHONE_AUTH_ENABLED=false
EXPO_PUBLIC_APPLE_AUTH_ENABLED=false

# Enable after configuring Google in Supabase and its redirect allowlist
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=false
