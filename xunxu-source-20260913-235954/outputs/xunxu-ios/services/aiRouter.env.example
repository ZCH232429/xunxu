# Node.js backend only. Endpoint IDs are non-secret; map them in Ark console.
EXPO_PUBLIC_EP_VISION=ep-your-vision-endpoint
EXPO_PUBLIC_EP_PRO=ep-your-planning-endpoint
EXPO_PUBLIC_EP_PRO_128K=ep-your-long-context-endpoint
EXPO_PUBLIC_EP_LITE=ep-your-text-endpoint
# Secret: never rename to EXPO_PUBLIC_ARK_API_KEY or put it in client config.
ARK_API_KEY=replace-in-server-secret-store

# Independent speech service (server only); fill only after opening the service.
# VOLC_ASR_API_KEY=
# VOLC_ASR_RESOURCE_ID=
# VOLC_TTS_API_KEY=
# VOLC_TTS_RESOURCE_ID=
# VOLC_TTS_VOICE=

# Optional independent secret for Lite; only set in the backend.
# ARK_LITE_API_KEY=
